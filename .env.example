# Token from @BotFather
BOT_TOKEN=
# Bot username without @ (used to build invite links)
BOT_USERNAME=
# Public domain with DNS pointing to this host (HTTPS is required by Telegram)
DOMAIN=attendance.example.com
POSTGRES_PASSWORD=change-me
# Only if the Mini App was created in BotFather with a short name (t.me/bot/<short>?startapp=...).
# Leave empty if it is set as the bot's Main Mini App (t.me/bot?startapp=...).
MINIAPP_SHORT_NAME=
# webhook (default) or polling; polling is only for local runs without public HTTPS
BOT_MODE=webhook
# Who sees the admin tab (all users and groups): comma-separated usernames and/or Telegram IDs
ADMIN_USERNAMES=
ADMIN_IDS=
